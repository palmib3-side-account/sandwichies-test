rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function orderStatus(data) {
      return data.get("status", "pendiente");
    }

    function paymentStatus(data) {
      return data.get("payment", {"status": "pendiente"}).get("status", "pendiente");
    }

    function validOrderStatusTransition() {
      let current = orderStatus(resource.data);
      let next = orderStatus(request.resource.data);
      let currentPayment = paymentStatus(resource.data);
      let nextPayment = paymentStatus(request.resource.data);

      return (
        current == next ||
        (current == "pendiente" && next == "confirmado") ||
        (current == "confirmado" && next == "preparando") ||
        (current == "preparando" && next == "listo") ||
        (current == "listo" && next == "entregado") ||
        (
          current == "pendiente" &&
          next == "cancelado" &&
          currentPayment == "pendiente" &&
          nextPayment == "pendiente"
        ) ||
        (
          current == "confirmado" &&
          next == "cancelado" &&
          currentPayment == "pendiente" &&
          nextPayment == "pendiente"
        ) ||
        (
          current == "preparando" &&
          next == "cancelado" &&
          currentPayment == "pendiente" &&
          nextPayment == "pendiente"
        ) ||
        (
          current == "listo" &&
          next == "cancelado" &&
          currentPayment == "pendiente" &&
          nextPayment == "pendiente"
        )
      );
    }

    function validPaymentStatusTransition() {
      let currentOrder = orderStatus(resource.data);
      let current = paymentStatus(resource.data);
      let next = paymentStatus(request.resource.data);

      return (
        (current == next) ||
        (current == "pendiente" && next == "pagado")
      ) && !(currentOrder == "cancelado" && current != next);
    }

    match /orders/{orderId} {
      // Customer writes are performed by the Admin SDK inside createOrder.
      // Admin state changes stay browser-accessible for the trusted admin role,
      // but status/payment transitions are validated by Rules.
      allow read: if isAdmin();
      allow update: if isAdmin()
        && validOrderStatusTransition()
        && validPaymentStatusTransition();
      allow create, delete: if false;
    }

    match /counters/orders {
      // The trusted function owns this counter transaction.
      allow read, write: if false;
    }

    match /inventoryBalances/{ingredientId} {
      // Balances are server-maintained from inventory transactions.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /inventoryTransactions/{transactionId} {
      // Inventory movements are created by privileged server code only.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
