{
  "name": "sandwich-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "functions/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/pricing.test.js test/business.test.js test/inventory.test.js",
    "security:rules": "node --test test/security.rules.test.js",
    "security:test": "firebase emulators:exec --only firestore --project demo-sandwichies \"npm run security:rules\"",
    "emulators:test": "npm run security:test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "smoke": "node scripts/smoke.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "check": "npm run audit && npm run lint && npm test && npm run security:test && npm run build && npm run smoke",
    "provision:admin": "node scripts/provision-admin.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "html2canvas": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
